{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SwiftLoad",
  "version": "0.1.0",
  "identifier": "com.swiftload.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "beforeBuildCommand": "npm --prefix ../ui run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "SwiftLoad",
        "width": 1160,
        "height": 740,
        "minWidth": 880,
        "minHeight": 520,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "windowEffects": {
          "effects": ["mica"]
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "A fast, honest download manager.",
    "longDescription": "SwiftLoad segments downloads across connections, adapts the connection count to what the server actually allows, and survives crashes, network loss and expired links without restarting from zero.",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": false
      }
    }
  }
}
